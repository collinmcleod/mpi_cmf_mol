#
# General Makefile defintions to allow CMFGEN etc to
# be compiled and linked.
#
# NOTE WELL: 
#      FG are options for f90 files in fixed format
#      FFREE are options for f90 files in free format.
#      FD are options for f90 files in fixed format with debug.
#      FFREED are options for f90 files in free format with debug.
#      The debug commands are generally not defined, and are not used
#         unless you manually edit the Makefiles.
#
# Installation directory for CMFGEN
# Site dependent.

# Define options for the ar command. On UBUNTU systems this might be Uruv

AR_OPTION = ruv

#HOST :=$(shell hostname)

HOST:=galah
DEBUG=nodebug

#DEBUG=nodebug

ifeq ($(HOST),galah)
INSTALL_DIR=/Users/jdh/mpi_cmfgen/
endif

COMPILE_OPT=$(HOST)_$(DEBUG)


ifeq ($(DEBUG),nodebug)
 MOD_DIR=$(INSTALL_DIR)mod/
 LIB_DIR=$(INSTALL_DIR)lib/
 EXE_DIR=$(INSTALL_DIR)exe/
endif

ifeq ($(DEBUG),debug)
 MOD_DIR=$(INSTALL_DIR)mod_dbg/
 LIB_DIR=$(INSTALL_DIR)lib_dbg/
 EXE_DIR=$(INSTALL_DIR)exe_dbg/
endif

ifeq ($(COMPILE_OPT),galah_nodebug)

F90 = mpif90 -fallow-argument-mismatch  -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib -fopenmp -m64
F90nomp = mpif90 -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib 
FG  = -O -ffixed-line-length-0 -fno-backslash -fd-lines-as-comments -fbacktrace -ffpe-trap=invalid -I$(MOD_DIR)
FD  = -g  -ffixed-line-length-0 -fbacktrace -fno-backslash -fbounds-check -fd-lines-as-comments -ffpe-trap=invalid,zero,overflow -I$(MOD_DIR) -J$(MOD_DIR)
FFREE  = -fno-backslash -O -I$(MOD_DIR) -J$(MOD_DIR)
FFRED  = -fno-backslash -g -I$(MOD_DIR) -J$(MOD_DIR)
BLAS=-lmy_blas
LAPACK=-lmy_lapack
X11LIB=-L/opt/X11/lib -lX11
PGLIB= -L/Users/jdh/pgplot_gfort/pgplot -lpgplot

endif


ifeq ($(COMPILE_OPT),galah_debug)
F90 = mpif90 -fallow-argument-mismatch  -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib -fopenmp -m64
F90nomp = mpif90 -L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib
FG  = -g  -ffixed-line-length-0 -fbacktrace -fno-backslash -fbounds-check -fd-lines-as-comments -ffpe-trap=invalid,zero,overflow -I$(MOD_DIR) -J$(MOD_DIR)
FD  = -g  -ffixed-line-length-0 -fbacktrace -fno-backslash -fbounds-check -fd-lines-as-comments -ffpe-trap=invalid,zero,overflow -I$(MOD_DIR) -J$(MOD_DIR)
FFREE  = -fno-backslash -g -I$(MOD_DIR) -J$(MOD_DIR)
FFRED  = -fno-backslash -g -I$(MOD_DIR) -J$(MOD_DIR)
BLAS=-lmy_blas
LAPACK=-lmy_lapack
X11LIB=-L/opt/X11/lib -lX11
PGLIB= -L/Users/jdh/pgplot_gfort/pgplot -lpgplot
endif

